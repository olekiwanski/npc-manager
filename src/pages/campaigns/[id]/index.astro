---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { NpcList } from "@/components/npcs/NpcList";
import { createClient } from "@/lib/supabase";
import type { Campaign, Npc } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return Astro.redirect("/auth/signin");
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/campaigns");
}

// RLS scopes this to the current user; a non-owner / missing id yields no row.
const campaignResult = await supabase.from("campaigns").select("*").eq("id", id).maybeSingle();
const campaign = campaignResult.data as Campaign | null;
if (!campaign) {
  return Astro.redirect("/campaigns");
}

// The campaign's NPC roster; RLS scopes it to the current user.
const npcResult = await supabase
  .from("npcs")
  .select("*")
  .eq("campaign_id", id)
  .order("created_at", { ascending: false });
const npcs = (npcResult.data ?? []) as Npc[];
---

<Layout title={campaign.name}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-5xl">
      <Topbar />
      <a
        href="/campaigns"
        class="mb-4 inline-block text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
      >
        ← Campaigns
      </a>
      <header class="mb-6 flex items-start justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            {campaign.name}
          </h1>
          {
            campaign.description ? (
              <p class="mt-2 max-w-2xl text-blue-100/70">{campaign.description}</p>
            ) : (
              <p class="mt-2 text-blue-100/40 italic">No description</p>
            )
          }
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <a
            href={`/campaigns/${id}/edit`}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20"
          >
            Edit campaign
          </a>
          <a
            href={`/campaigns/${id}/npcs/new`}
            class="inline-flex items-center gap-2 rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            + New NPC
          </a>
        </div>
      </header>
      <h2 class="mb-4 text-xl font-semibold text-white">NPCs</h2>
      <NpcList initialNpcs={npcs} campaignId={id} client:load />
    </div>
  </div>
</Layout>
