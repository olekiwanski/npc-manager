---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { Npc } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return Astro.redirect("/auth/signin");
}

const { id, npcId } = Astro.params;
if (!id || !npcId) {
  return Astro.redirect("/campaigns");
}

// RLS scopes this to the current user; a non-owner / missing id yields no row.
const result = await supabase.from("npcs").select("*").eq("id", npcId).maybeSingle();
const npc = result.data as Npc | null;
if (!npc) {
  return Astro.redirect(`/campaigns/${id}`);
}
---

<Layout title={npc.name}>
  <div class="bg-cosmic flex min-h-screen items-start justify-center p-4">
    <div class="mt-16 w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <div class="mb-6 flex items-start justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            {npc.name}
          </h1>
          {
            npc.role ? (
              <p class="mt-1 text-purple-200">{npc.role}</p>
            ) : (
              <p class="mt-1 text-blue-100/40 italic">No role</p>
            )
          }
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <a
            href={`/campaigns/${id}/npcs/${npcId}/edit`}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20"
          >
            Edit
          </a>
          <a
            href={`/campaigns/${id}`}
            class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            ← Back
          </a>
        </div>
      </div>

      <h2 class="mb-2 text-sm font-semibold tracking-wide text-blue-100/60 uppercase">Traits</h2>
      {
        npc.traits ? (
          <p class="whitespace-pre-wrap text-blue-100/90">{npc.traits}</p>
        ) : (
          <p class="text-blue-100/40 italic">No traits</p>
        )
      }
    </div>
  </div>
</Layout>
