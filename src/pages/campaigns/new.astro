---
import Layout from "@/layouts/Layout.astro";
import { CampaignForm } from "@/components/campaigns/CampaignForm";

// Middleware already gates /campaigns; this is a defensive safety check.
// Pages that need a Supabase client (index.astro, edit.astro) use createClient() whose null check
// doubles as an auth guard. This page has no SSR query so we check Astro.locals.user directly.
if (!Astro.locals.user) {
  return Astro.redirect("/auth/signin");
}
---

<Layout title="New Campaign">
  <div class="bg-cosmic flex min-h-screen items-start justify-center p-4">
    <div class="mt-16 w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-amber-200 to-yellow-200 bg-clip-text text-2xl font-bold text-transparent">
          New Campaign
        </h1>
        <a href="/campaigns" class="text-sm text-amber-300 transition-colors hover:text-amber-100 hover:underline">
          ← Back
        </a>
      </div>
      <CampaignForm client:load />
    </div>
  </div>
</Layout>
